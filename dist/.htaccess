<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Si el archivo o directorio existe en el servidor, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Si un recurso dentro de /assets/ no existe, devolver 404 (evita entregar HTML ante scripts JS/CSS faltantes)
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [R=404,L]

  # Rutas de la SPA: redirigir a index.html
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Nunca cachear index.html para garantizar que el navegador siempre cargue los hashes de chunks vigentes
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cachear assets estáticos con hash inmutable
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
